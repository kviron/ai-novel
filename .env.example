# MODEL_CONTEXT_WINDOWS={"ollama:qwen3:14b-q4_K_M":32768}
# Optional separate model for confirmed-turn summaries; its window must be configured above if non-Ollama.
# MEMORY_PROVIDER_ID=ollama
# MEMORY_MODEL_ID=qwen3:14b-q4_K_M
PROVIDER_TIMEOUT_SECONDS=120
