APP_MODE=demo
DATABASE_PATH=data/visual-novel.db
ASSET_DIR=data/assets
CORS_ORIGINS=http://localhost:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b-q4_K_M
OLLAMA_CONTEXT_TOKENS=16384
